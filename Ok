<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <title>Heroic Abilities Worksheet | Classic Style PDF</title>
    <!-- html2pdf bundle (html2canvas + jsPDF) для надёжного захвата -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js" integrity="sha512-GsLlZN/3F2ErC5ifS5QtgpiJtWd43JWSuIgh7mbzZ8zBps+dvLusV+eNQATqgA/HdeKFVgA5v3S/cIrLF7QnIg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* ===== КЛАССИЧЕСКИЙ ШРИФТ ===== */
        body, .worksheet-container, .hero-card, .question-item, .download-btn, footer {
            font-family: 'Georgia', 'Times New Roman', Times, serif;
        }

        body {
            background-color: #2c2a2a; /* тёмный классический фон */
        }

        /* ФОН-РАМОЧКА: УМЕНЬШЕН В ТРИ РАЗА (background-size: 33% авто, повторяется для обрамления) */
        .frame {
            background-image: url('Photos/Screenshot_20260407_005538_Pinterest.jpg');
            background-size: 33% auto;     /* уменьшен в 3 раза по ширине */
            background-repeat: repeat;      /* повторяющийся узор, создаёт эффект декоративной рамки */
            background-position: top left;
            background-color: #fef3da;      /* тёплый базовый цвет, если картинка не загрузится */
            padding: 2rem 1.5rem;
            border-radius: 36px;
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.4);
            margin: 20px;
        }

        .worksheet-container {
            max-width: 1400px;
            margin: 0 auto;
            background-color: rgba(250, 245, 235, 0.92); /* полупрозрачный для читаемости */
            border-radius: 28px;
            padding: 1.5rem 1rem;
            box-shadow: inset 0 0 0 1px rgba(255,245,200,0.6), 0 10px 20px rgba(0,0,0,0.2);
        }

        /* Заголовок классическим шрифтом, элегантный */
        .main-title {
            text-align: center;
            font-size: 2.4rem;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 1.8rem;
            color: #2c2418;
            background: #eeddbb;
            display: inline-block;
            width: auto;
            padding: 0.4rem 2rem;
            border-radius: 60px;
            box-shadow: 0 5px 12px rgba(0,0,0,0.2);
            font-family: 'Georgia', 'Times New Roman', serif;
            border: 1px solid #c9aa6f;
        }

        /* сетка карточек */
        .hero-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
            gap: 28px;
            margin-top: 20px;
        }

        /* карточка: классическая тень, светлый фон для контраста */
        .hero-card {
            background: #fffef7;
            border-radius: 32px;
            padding: 1.2rem 1rem 1.5rem 1rem;
            text-align: center;
            transition: transform 0.2s;
            box-shadow: 0 12px 20px rgba(0, 0, 0, 0.2);
            border: 1px solid #e2cfaa;
        }

        .hero-card:hover {
            transform: translateY(-4px);
        }

        /* Все фото одинакового размера (квадратные, округлые) */
        .hero-img {
            width: 160px;
            height: 160px;
            object-fit: cover;
            border-radius: 50%;
            border: 3px solid #c9aa6f;
            box-shadow: 0 5px 12px rgba(0, 0, 0, 0.3);
            background-color: #f3e9ce;
            margin-bottom: 15px;
        }

        /* Имя персонажа: крупное, классическое, контрастное */
        .hero-name {
            font-size: 1.9rem;
            font-weight: 700;
            margin: 10px 0 12px;
            color: #2b4f2b;
            text-shadow: none;
            letter-spacing: 1px;
            font-family: 'Georgia', 'Times New Roman', serif;
            border-bottom: 2px solid #e2cfaa;
            display: inline-block;
            padding-bottom: 4px;
        }

        /* Вопросы: классический стиль, хорошо читаемый */
        .question-item {
            background: #fdf8ed;
            border-radius: 28px;
            padding: 12px 12px;
            margin: 14px 6px;
            font-size: 1.1rem;
            font-weight: 600;
            color: #2c2b26;
            text-align: center;
            line-height: 1.45;
            box-shadow: inset 0 1px 3px rgba(0,0,0,0.05), 0 2px 6px rgba(0,0,0,0.1);
            font-family: 'Georgia', 'Times New Roman', serif;
            border-left: 6px solid #b8860b;
        }

        /* Кнопка скачивания: быстрая, надёжная */
        .download-btn {
            display: block;
            margin: 45px auto 25px auto;
            background: #3d5a3d;
            border: none;
            padding: 14px 32px;
            font-size: 1.4rem;
            font-weight: bold;
            font-family: 'Georgia', 'Times New Roman', serif;
            color: #fff3e0;
            border-radius: 60px;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
            transition: 0.1s linear;
            width: fit-content;
            letter-spacing: 0.5px;
        }

        .download-btn:hover {
            background: #2c482c;
            transform: scale(1.02);
            box-shadow: 0 10px 20px black;
        }

        /* адаптация */
        @media (max-width: 650px) {
            .hero-img {
                width: 130px;
                height: 130px;
            }
            .hero-name {
                font-size: 1.6rem;
            }
            .question-item {
                font-size: 1rem;
            }
            .frame {
                padding: 1rem;
                margin: 10px;
            }
        }

        /* печать / pdf */
        @media print {
            .download-btn {
                display: none;
            }
            .hero-card {
                break-inside: avoid;
                page-break-inside: avoid;
            }
        }

        footer {
            text-align: center;
            margin-top: 30px;
            font-size: 0.8rem;
            color: #5c4b2a;
            background: #e9ddbc;
            width: fit-content;
            margin-left: auto;
            margin-right: auto;
            padding: 6px 20px;
            border-radius: 40px;
            font-style: italic;
        }
    </style>
</head>
<body>

<div class="frame">
    <div class="worksheet-container">
        <div style="display: flex; justify-content: center;">
            <h1 class="main-title">⚡ CAN YOU...? ⚡<br> HEROIC ABILITIES WORKSHEET</h1>
        </div>

        <div class="hero-grid" id="heroCardsGrid"></div>

        <div style="display: flex; justify-content: center;">
            <button class="download-btn" id="pdfDownloadBtn">📥 SAVE AS PDF (FULL WORKSHEET) 📄</button>
        </div>
        <footer>✨ Classic style — each hero answers two imaginative "Can you...?" questions ✨</footer>
    </div>
</div>

<script>
    // --------------------------------------------------------------
    // ДАННЫЕ ПЕРСОНАЖЕЙ (ФОТО + ВОПРОСЫ)
    // ОБНОВЛЕНО: для Thor другой путь к фото
    // --------------------------------------------------------------
    const heroesData = [
        {
            name: "Thor",
            imgSrc: "Photos/Screenshot_20260408_004618_Pinterest.png",  // НОВАЯ ССЫЛКА
            questions: [
                "⚡📱 Can you charge my phone just by holding it for a second?",
                "⚡🥛 Can you heat up a cup of cold milk with your lightning powers?"
            ]
        },
        {
            name: "Spider-Man",
            imgSrc: "Photos/Screenshot_20260404_141131_Pinterest.png",
            questions: [
                "🕸️🛏️ Can you make a giant spider-web swing in my bedroom?",
                "🕸️🤸‍♂️ Can you use your webs to make a big trampoline for us to jump on?"
            ]
        },
        {
            name: "Hulk",
            imgSrc: "Photos/Screenshot_20260404_141201_Pinterest.png",
            questions: [
                "✏️🎨🔍 Can you draw a tiny picture with a very small pencil?",
                "🤲🌷 Can you hold something delicate without crushing it?"
            ]
        },
        {
            name: "Iron Man",
            imgSrc: "Photos/Screenshot_20260404_141223_Pinterest.png",
            questions: [
                "🔫🏟️ Can you turn my room into a laser tag arena with your repulsor blasts?",
                "⚛️🚀 Can you make my bedroom zero gravity with your arc reactor?"
            ]
        },
        {
            name: "Black Panther",
            imgSrc: "Photos/Screenshot_20260404_141301_Pinterest.png",
            questions: [
                "👻🐈 Can you turn invisible and scare my cat at home?",
                "🍕 Can you cut a pizza into perfect slices with your sharp claws?"
            ]
        },
        {
            name: "Ant-Man",
            imgSrc: "Photos/Screenshot_20260404_141326_Pinterest.png",
            questions: [
                "🚗🫨🏠 Can you get very small and drive my toy car around the house?",
                "🤏✨ Can you shrink and whisper the correct answers to me during my math test?"
            ]
        },
        {
            name: "Evil Minion",
            imgSrc: "Photos/Screenshot_20260404_141413_Pinterest.png",
            questions: [
                "🍌🎵 Can you sing the \"Banana Song\" all day long?",
                "🎒👻 Can you hide inside my backpack and scare my friends?"
            ]
        },
        {
            name: "Harry Potter",
            imgSrc: "Photos/Screenshot_20260404_141439_Pinterest.png",
            questions: [
                "✏️🪄 Can you turn my pencil into a wand?",
                "✨😊 Can you help me make my day better with a little magic?"
            ]
        },
        {
            name: "Dobby",
            imgSrc: "Photos/Screenshot_20260404_141504_Pinterest.png",
            questions: [
                "📚😂 Can you turn my maths textbook into a funny comic book?",
                "✏️💃 Can you make all the pencils in the classroom dance?"
            ]
        },
        {
            name: "Doctor Strange",
            imgSrc: "Photos/Screenshot_20260404_141639_Pinterest.png",
            questions: [
                "☁️🛏️ Can you create a giant fluffy cloud in my bedroom?",
                "🌀🏍️ Can you open a portal to the motorcycle racing track in my bedroom?"
            ]
        },
        {
            name: "Luke Skywalker",
            imgSrc: "Photos/Screenshot_20260404_141801_Pinterest.png",
            questions: [
                "🌌🧸 Can you use the Force to make my toys float in the air?",
                "⚔️✨ Can you give me a lightsaber that sparkles when I swing it?"
            ]
        },
        {
            name: "Pikachu",
            imgSrc: "Photos/Screenshot_20260404_141826_Pinterest.png",
            questions: [
                "⚡💡 Can you light up a light bulb with your Thunderbolt?",
                "⚡🖊️😂 Can you use your lightning bolt-shaped tail to draw a funny picture for me?"
            ]
        },
        {
            name: "Superman",
            imgSrc: "Photos/Screenshot_20260404_141855_Pinterest.png",
            questions: [
                "🍿🏔️ Can you make a giant mountain of popcorn with your heat vision?",
                "🎈💨🎉 Can you inflate all the balloons for a birthday party with your super breath?"
            ]
        },
        {
            name: "Elsa",
            imgSrc: "Photos/Screenshot_20260404_142009_Pinterest.png",
            questions: [
                "❄️🫧🧥 Can you make a tiny snowflake that never melts, so I can keep it in my pocket forever?",
                "🍦☀️ Can you use your ice powers to keep my ice cream from melting on a sunny day?"
            ]
        }
    ];

    // Рендер карточек
    const gridContainer = document.getElementById("heroCardsGrid");

    function buildHeroCard(hero) {
        const card = document.createElement("div");
        card.className = "hero-card";

        const img = document.createElement("img");
        img.className = "hero-img";
        img.src = hero.imgSrc;
        img.alt = hero.name;
        img.onerror = function() {
            this.onerror = null;
            this.src = "https://placehold.co/160x160?text=" + encodeURIComponent(hero.name) + "&font=georgia";
            this.style.backgroundColor = "#dfd2b0";
        };

        const nameEl = document.createElement("h2");
        nameEl.className = "hero-name";
        nameEl.textContent = hero.name;

        const question1 = document.createElement("div");
        question1.className = "question-item";
        question1.textContent = hero.questions[0];

        const question2 = document.createElement("div");
        question2.className = "question-item";
        question2.textContent = hero.questions[1];

        card.appendChild(img);
        card.appendChild(nameEl);
        card.appendChild(question1);
        card.appendChild(question2);
        return card;
    }

    heroesData.forEach(hero => {
        gridContainer.appendChild(buildHeroCard(hero));
    });

    // --------------------------------------------------------------
    // ФУНКЦИЯ ГЛАДКОГО И ПОЛНОГО СКАЧИВАНИЯ PDF
    // - предзагрузка всех изображений (включая фоновое)
    // - оптимизированные настройки html2pdf без потери содержимого
    // - обработка ошибок, быстрый отклик
    // --------------------------------------------------------------
    const downloadBtn = document.getElementById("pdfDownloadBtn");

    // Вспомогательная функция: предзагрузка всех изображений на странице и фонового изображения
    async function preloadAllImages() {
        const images = document.querySelectorAll('img');
        const bgImageElement = document.querySelector('.frame');
        let bgUrl = null;
        if (bgImageElement) {
            const bgStyle = window.getComputedStyle(bgImageElement);
            const bgImage = bgStyle.backgroundImage;
            if (bgImage && bgImage !== 'none') {
                const match = bgImage.match(/url\(["']?(.*?)["']?\)/);
                if (match && match[1]) bgUrl = match[1];
            }
        }
        
        const loadImage = (src) => {
            return new Promise((resolve) => {
                if (!src) return resolve();
                const img = new Image();
                img.crossOrigin = "Anonymous";
                img.onload = () => resolve();
                img.onerror = () => resolve(); // не блокируем
                img.src = src;
            });
        };

        const promises = [];
        images.forEach(img => {
            if (img.src) promises.push(loadImage(img.src));
        });
        if (bgUrl) promises.push(loadImage(bgUrl));
        
        await Promise.all(promises);
    }

    async function generateAndDownloadPDF() {
        // Блокируем кнопку на время генерации
        const originalText = downloadBtn.innerText;
        downloadBtn.innerText = "⏳ Preparing PDF, please wait...";
        downloadBtn.disabled = true;
        downloadBtn.style.opacity = "0.6";
        
        try {
            // Предзагрузка всех изображений (чтобы PDF захватил их полностью)
            await preloadAllImages();
            
            // Элемент для захвата (весь frame со всем содержимым)
            const elementToCapture = document.querySelector('.frame');
            if (!elementToCapture) throw new Error("Frame element not found");
            
            // Дополнительная задержка для стабилизации (50мс)
            await new Promise(r => setTimeout(r, 80));
            
            // Настройки PDF: высокое качество, A4, полное содержимое
            const opt = {
                margin:        [0.5, 0.5, 0.5, 0.5], // mm
                filename:     'Superhero_CanYou_Worksheet_Classic.pdf',
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { 
                    scale: 2.8,                 // высокое разрешение для чёткого текста и фона
                    useCORS: true,
                    logging: false,
                    letterRendering: true,
                    backgroundColor: '#FFFEF7'  // светлый фон для чистоты
                },
                jsPDF:        { 
                    unit: 'mm', 
                    format: 'a4', 
                    orientation: 'portrait' 
                },
                pagebreak:    { mode: ['css', 'legacy'] } // автоматические разрывы
            };
            
            // Генерируем и скачиваем
            await html2pdf().set(opt).from(elementToCapture).save();
            
        } catch (error) {
            console.error("PDF generation error:", error);
            alert("⚠️ PDF could not be generated. However, you can use the browser's Print (Ctrl+P) and save as PDF for a perfect backup. Error: " + error.message);
        } finally {
            downloadBtn.innerText = originalText;
            downloadBtn.disabled = false;
            downloadBtn.style.opacity = "1";
        }
    }
    
    downloadBtn.addEventListener("click", generateAndDownloadPDF);
    
    // Дополнительно: предзагружаем изображения при загрузке страницы, чтобы первое нажатие было быстрым
    window.addEventListener('load', () => {
        preloadAllImages().then(() => {
            console.log("All images preloaded for fast PDF export");
        });
        // Добавляем fallback для локальных путей: если фото не загрузились, в PDF подставятся плейсхолдеры
    });
</script>

<!-- 
    ИТОГОВЫЕ УЛУЧШЕНИЯ:
    1. Текст всего документа стал классическим (Georgia/Times).
    2. Фото Тора заменено на Photos/Screenshot_20260408_004618_Pinterest.png.
    3. Скачивание PDF теперь происходит гладко и быстро: добавлена предзагрузка всех изображений,
       оптимизированные параметры html2pdf, надёжные обработчики ошибок, захватывается абсолютно всё содержимое
       (включая уменьшенный фоновый узор, все карточки, вопросы, заголовки).
    4. Задний фон (рамка) уменьшен в три раза: background-size: 33% auto; повторяется (repeat),
       создаёт аккуратный декоративный фон, не перегружая документ.

    Для корректной работы:
    - Разместите HTML в папке с подпапкой "Photos", где лежат все указанные изображения.
    - Новый файл Thor: Screenshot_20260408_004618_Pinterest.png
    - Обязательно наличие фонового файла: Screenshot_20260407_005538_Pinterest.jpg
    - Если каких-то файлов нет, заглушки сохранят макет.
-->
</body>
</html>
